# КВЕРАТО VK v1.0 — настройка официального релиза.
# Скопируй этот файл в .env. Никому не отправляй файл .env и VK_TOKEN.
VK_TOKEN=
KVERATO_DB_PATH=data/kverato.sqlite3

# VK ID владельца бота (число без id). Несколько ID — через запятую.
KVERATO_OWNER_IDS=

# Ежедневная резервная копия SQLite перед запуском (рекомендуется).
KVERATO_AUTO_BACKUP=1

# Отправка графических карточек: 1 — включено, 0 — только текст.
KVERATO_IMAGE_CARDS=1

# Формат загрузки карточек: auto, jpeg или png.
KVERATO_IMAGE_UPLOAD_FORMAT=auto

# При ошибке Photos API отправить PNG как документ VK.
KVERATO_IMAGE_DOCUMENT_FALLBACK=1
