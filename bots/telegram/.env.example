# Создай копию этого файла с именем .env и вставь токен от @BotFather.
# Никому не сообщай токен и не загружай .env в публичный репозиторий.
TELEGRAM_TOKEN=
# ТВОЙ ЧИСЛОВОЙ Telegram User ID (не VK ID) для панели «админ».
# Несколько владельцев через запятую. Не выдавай доступ случайным людям.
TELEGRAM_OWNER_IDS=
# Отдельная база Telegram; НЕ копируй сюда VK-базу без особой необходимости.
KVERATO_DB_PATH=data/kverato_telegram.sqlite3
KVERATO_AUTO_BACKUP=1
KVERATO_IMAGE_CARDS=1
# Владелец может проверить работу через /status в личном чате.
