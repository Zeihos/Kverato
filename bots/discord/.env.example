# Создай .env рядом с main.py и задай токен Discord-бота.
# Не публикуй токен, .env или базу игроков.
DISCORD_TOKEN=
# Твои цифровые Discord User ID; несколько через запятую.
DISCORD_OWNER_IDS=
# Необязательно: сервер для быстрой регистрации slash-команд при тестировании.
# Для глобальных команд оставь пустым. В обоих случаях DM-команды доступны.
# При указанном сервере команды синхронизируются и глобально для личных сообщений.
DISCORD_GUILD_ID=
KVERATO_DB_PATH=data/kverato_discord.sqlite3
KVERATO_AUTO_BACKUP=1
KVERATO_IMAGE_CARDS=1
