root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,yml,yaml,json,svg,html}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.{png,jpg,jpeg,ico,zip}]
insert_final_newline = unset
trim_trailing_whitespace = unset
